{
    "name": "erfanvahabpour/bale-bot-sdk",
    "description": "The Unofficial Bale Bot API PHP SDK",
    "license": "BSD-4-Clause",
    "type": "library",
    "keywords": [
        "bale",
        "bale bot",
        "bale bot api",
        "bale sdk",
        "bale php",
        "laravel bale",
        "laravel"
    ],
    "authors": [
        {
            "name": "Erfan Vahabpour",
            "email": "erfanvahabpour@yahoo.com",
            "homepage": "https://erfanvahabpour.ir/",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@efive.net",
        "docs": "https://bale-bot-sdk.efive.net"
    },
    "funding": [
        {
            "type": "aqayepardakht",
            "url": "https://aqayepardakht.ir/efive"
        }
    ],
    "homepage": "https://github.com/ErfanVahabpour/Bale-Bot-SDK",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.7",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "EFive\\Bale\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EFive\\Bale\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "aliases": {
                "Bale": "EFive\\Bale\\Laravel\\Facades\\Bale"
            },
            "providers": [
                "EFive\\Bale\\Laravel\\BaleServiceProvider"
            ]
        }
    }
}
